{
  "name": "@deseteral/biurko",
  "version": "0.1.0",
  "description": "A browser window manager with React and SolidJS adapters.",
  "homepage": "https://github.com/Deseteral/biurko#readme",
  "bugs": {
    "url": "https://github.com/Deseteral/biurko/issues"
  },
  "license": "MIT",
  "author": "Deseteral",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deseteral/biurko.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/solid-js": {
      "types": "./dist/adapters/solid-js/index.d.ts",
      "import": "./dist/adapters/solid-js/index.js"
    },
    "./adapters/react": {
      "types": "./dist/adapters/react/index.d.ts",
      "import": "./dist/adapters/react/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:demo": "vp build demo/",
    "prepack": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "demo": "vp dev demo/"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "solid-js": "1.8.15",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-solid": "2.11.6",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "solid-js": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "packageManager": "npm@11.20.0"
}
