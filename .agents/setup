#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Node.js is provided by the orb base image.
if [[ "$(npm --version)" != "11.20.0" ]]; then
  echo "Installing npm 11.20.0"
  time npm install --global npm@11.20.0
fi

echo "Using Node.js $(node --version) and npm $(npm --version)"
echo "Installing dependencies from package-lock.json"
time npm ci
